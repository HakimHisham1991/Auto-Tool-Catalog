<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auto Tool Catalog</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoToolCatalog.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var appVersion = ViewData["AppVersion"]?.ToString() ?? "2.2.0";
    }
    <header class="border-bottom box-shadow mb-3 bg-white">
        <div class="container py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                <div>
                    <p class="text-muted mb-0">Auto Tool Catalog</p>
                    <p class="text-muted mb-0">v@(appVersion)</p>
                    <p class="text-muted small mb-0">Developed by UPECA PDC</p>
                </div>
                <p class="text-muted mb-0 ms-md-auto app-header-tagline">Import Excel, fetch specs from supplier sites, export full tooling data.</p>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Auto Tool Catalog - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
