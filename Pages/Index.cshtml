@page
@model AutoToolCatalog.Pages.IndexModel
@{
    ViewData["Title"] = "Auto Tool Catalog";
    const string AppVersion = "2.1.0";
    ViewData["AppVersion"] = AppVersion;
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-auto">
                <label class="form-label">Import Excel</label>
                <input type="file" id="fileInput" class="form-control" accept=".xlsx" />
            </div>
            <div class="col-auto d-flex align-items-end">
                <button type="button" id="btnImport" class="btn btn-primary">Import Excel</button>
            </div>
            <div class="col-auto d-flex align-items-end">
                <a href="/api/sample" class="btn btn-outline-secondary">Download Sample</a>
            </div>
            <div class="col-auto d-flex align-items-end">
                <button type="button" id="btnProcess" class="btn btn-success" disabled>Process / Fetch Specs</button>
            </div>
            <div class="col-auto d-flex align-items-end">
                <button type="button" id="btnStop" class="btn btn-danger" style="display: none;">Stop</button>
            </div>
            <div class="col-auto d-flex align-items-end">
                <button type="button" id="btnExport" class="btn btn-outline-primary" disabled>Export Completed Excel</button>
            </div>
        </div>
    </div>
</div>

<div id="progressSection" class="card mb-4" style="display: none;">
    <div class="card-header" id="progressTitle">Progress</div>
    <div class="card-body">
        <div class="progress mb-2" style="height: 24px;">
            <div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%">0%</div>
        </div>
        <div class="row small" id="progressStats">
            <div class="col-md-2">Success: <strong id="successCount">0</strong></div>
            <div class="col-md-2">Failed: <strong id="failCount">0</strong></div>
            <div class="col-md-8">Current: <span id="currentItem" class="text-muted">—</span></div>
        </div>
        <div class="small text-muted mt-2" id="processNote">
            Note: SECO rows without a Link use browser lookup and may take about 1–2 minutes per row.
        </div>
        <div class="small text-muted" id="importStatus" style="display: none;">
            Status: <span id="importStatusText">—</span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Data Preview</span>
        <span id="recordCount" class="badge bg-secondary">0 rows</span>
    </div>
    <div class="card-body p-0 table-responsive">
        <table id="dataPreviewTable" class="table table-sm table-striped table-bordered mb-0 data-preview-table">
            <thead class="table-light">
                <tr id="tableHeadRow">
                    <th>No.</th>
                    <th>Tool Description</th>
                    <th>Supplier</th>
                    <th class="col-link">Link</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="4" class="text-center text-muted">Import an Excel file to begin.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        let sessionId = null;
        let connection = null;
        let propertyColumns = [];

        function coreColumnCount() { return 4; }
        function totalColumnCount() { return coreColumnCount() + propertyColumns.length; }

        function renderTableHead(columns) {
            propertyColumns = columns || [];
            const head = document.getElementById('tableHeadRow');
            head.innerHTML =
                '<th>No.</th>' +
                '<th>Tool Description</th>' +
                '<th>Supplier</th>' +
                '<th class="col-link">Link</th>' +
                propertyColumns.map(c => `<th>${escapeHtml(c)}</th>`).join('');
        }

        function setProgressBar(percent, animated) {
            const bar = document.getElementById('progressBar');
            const pct = Math.max(0, Math.min(100, Math.round(percent)));
            bar.style.width = pct + '%';
            bar.textContent = pct + '%';
            bar.className = 'progress-bar' + (animated ? ' progress-bar-striped progress-bar-animated' : '');
        }

        function showImportProgress() {
            document.getElementById('progressTitle').textContent = 'Import Progress';
            document.getElementById('progressStats').style.display = 'none';
            document.getElementById('importStatus').style.display = '';
            document.getElementById('progressSection').style.display = 'block';
            setProgressBar(0, true);
            document.getElementById('importStatusText').textContent = 'Starting import...';
        }

        function showProcessingProgress() {
            document.getElementById('progressTitle').textContent = 'Progress';
            document.getElementById('progressStats').style.display = '';
            document.getElementById('importStatus').style.display = 'none';
            document.getElementById('successCount').textContent = '0';
            document.getElementById('failCount').textContent = '0';
            document.getElementById('currentItem').textContent = '\u2014';
        }

        function finishImportProgress(message) {
            setProgressBar(100, false);
            document.getElementById('importStatusText').textContent = message;
            document.getElementById('progressBar').classList.add('bg-success');
        }

        function resetImportProgressBar() {
            document.getElementById('progressBar').classList.remove('bg-success', 'bg-warning');
        }

        function uploadExcel(formData) {
            return new Promise((resolve, reject) => {
                const xhr = new XMLHttpRequest();
                xhr.open('POST', '/api/upload');
                let uploadFinished = false;

                xhr.upload.addEventListener('progress', (e) => {
                    if (e.lengthComputable && e.total > 0) {
                        const uploadPct = Math.round((e.loaded / e.total) * 55);
                        setProgressBar(uploadPct, true);
                        document.getElementById('importStatusText').textContent =
                            `Uploading file... (${Math.round((e.loaded / e.total) * 100)}%)`;
                    } else {
                        setProgressBar(25, true);
                        document.getElementById('importStatusText').textContent = 'Uploading file...';
                    }
                });

                xhr.upload.addEventListener('load', () => {
                    uploadFinished = true;
                    setProgressBar(60, true);
                    document.getElementById('importStatusText').textContent = 'Parsing Excel on server...';
                });

                xhr.addEventListener('load', () => {
                    let data = {};
                    if (xhr.responseText) {
                        try {
                            data = JSON.parse(xhr.responseText);
                        } catch {
                            if (xhr.status >= 400) {
                                reject(new Error(xhr.responseText.trim() || 'Upload failed'));
                                return;
                            }
                        }
                    }

                    if (xhr.status >= 200 && xhr.status < 300) {
                        resolve(data);
                        return;
                    }

                    reject(new Error(data.title || data.detail || xhr.responseText || 'Upload failed'));
                });

                xhr.addEventListener('error', () => reject(new Error('Upload failed')));
                xhr.addEventListener('timeout', () => reject(new Error('Upload timed out')));
                xhr.timeout = 300000;
                xhr.send(formData);

                if (!uploadFinished) {
                    setProgressBar(10, true);
                    document.getElementById('importStatusText').textContent = 'Uploading file...';
                }
            });
        }

        // ── SignalR setup ──────────────────────────────────────────────
        async function ensureConnection() {
            if (connection) return;
            connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/processing')
                .withAutomaticReconnect()
                .build();

            // Real-time progress bar updates
            connection.on('ProgressUpdate', p => {
                setProgressBar(p.percentComplete, !p.isFinished && !p.isStopped);
                document.getElementById('successCount').textContent = p.successCount ?? 0;
                document.getElementById('failCount').textContent = p.failCount ?? 0;
                document.getElementById('currentItem').textContent = p.currentItem || '\u2014';

                if (p.isFinished || p.isStopped) {
                    onProcessingDone(p.isStopped);
                    loadTable();
                }
            });

            // Real-time row-by-row record updates
            connection.on('RecordUpdated', msg => {
                if (msg.columns) renderTableHead(msg.columns);
                const row = document.getElementById('row-' + msg.index);
                if (!row) return;
                row.innerHTML = buildRowCells(msg.row);
                row.classList.add('table-success');
                setTimeout(() => row.classList.remove('table-success'), 1500);
            });

            connection.on('ColumnsUpdated', columns => {
                renderTableHead(columns);
                loadTable();
            });

            wireConnectionHandlers();
            await connection.start();
        }

        function wireConnectionHandlers() {
            if (!connection || connection._handlersWired) return;
            connection._handlersWired = true;
            connection.onreconnected(async () => {
                if (sessionId) await connection.invoke('JoinSession', sessionId);
            });
        }

        function onProcessingDone(wasStopped) {
            document.getElementById('btnProcess').disabled = false;
            document.getElementById('btnStop').style.display = 'none';
            if (wasStopped) {
                document.getElementById('currentItem').textContent = 'Stopped by user';
                document.getElementById('progressBar').classList.remove('progress-bar-animated', 'progress-bar-striped');
                document.getElementById('progressBar').classList.add('bg-warning');
            }
        }

        // ── Import ─────────────────────────────────────────────────────
        document.getElementById('btnImport').addEventListener('click', async () => {
            const input = document.getElementById('fileInput');
            if (!input.files?.length) {
                alert('Please select an Excel file.');
                return;
            }

            const btnImport = document.getElementById('btnImport');
            btnImport.disabled = true;
            resetImportProgressBar();
            showImportProgress();

            const formData = new FormData();
            formData.append('file', input.files[0]);
            try {
                const data = await uploadExcel(formData);
                setProgressBar(85, true);
                document.getElementById('importStatusText').textContent = 'Loading preview...';
                sessionId = data.sessionId;
                document.getElementById('btnProcess').disabled = false;
                document.getElementById('btnExport').disabled = false;
                document.getElementById('recordCount').textContent = data.count + ' rows';
                await loadTable();
                finishImportProgress(`Import complete (${data.count} rows)`);
            } catch (e) {
                document.getElementById('progressSection').style.display = 'block';
                setProgressBar(100, false);
                document.getElementById('progressBar').classList.add('bg-danger');
                document.getElementById('importStatusText').textContent = 'Import failed';
                alert('Upload failed: ' + e.message);
            } finally {
                btnImport.disabled = false;
            }
        });

        // ── Process ────────────────────────────────────────────────────
        document.getElementById('btnProcess').addEventListener('click', async () => {
            if (!sessionId) return;

            // Reset UI
            document.getElementById('btnProcess').disabled = true;
            document.getElementById('btnStop').style.display = '';
            resetImportProgressBar();
            showProcessingProgress();
            document.getElementById('progressSection').style.display = 'block';
            setProgressBar(0, true);

            try {
                await ensureConnection();
                await connection.invoke('JoinSession', sessionId);
                const res = await fetch('/api/process/' + sessionId, { method: 'POST' });
                if (!res.ok) throw new Error('Failed to start processing');
            } catch (e) {
                alert('Error: ' + e.message);
                document.getElementById('btnProcess').disabled = false;
                document.getElementById('btnStop').style.display = 'none';
            }
        });

        // ── Stop ───────────────────────────────────────────────────────
        document.getElementById('btnStop').addEventListener('click', async () => {
            if (!sessionId) return;
            document.getElementById('btnStop').disabled = true;
            try {
                await fetch('/api/stop/' + sessionId, { method: 'POST' });
            } catch (e) {
                console.error('Stop failed:', e);
            }
        });

        // ── Table ──────────────────────────────────────────────────────
        async function loadTable() {
            if (!sessionId) return;
            const res = await fetch('/api/records/' + sessionId);
            const data = await res.json();
            renderTableHead(data.columns || []);
            const rows = data.rows;
            const tbody = document.getElementById('tableBody');
            if (!rows || rows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="${totalColumnCount()}" class="text-center text-muted">No data.</td></tr>`;
                return;
            }
            tbody.innerHTML = rows.map((r, i) =>
                `<tr id="row-${i}">${buildRowCells(r)}</tr>`
            ).join('');
        }

        function buildRowCells(r) {
            let html =
                `<td>${r.no}</td>` +
                `<td>${escapeHtml(r.toolDescription)}</td>` +
                `<td>${escapeHtml(r.procurementChannel)}</td>` +
                `<td class="col-link">${formatLinkCell(r.webpageLink)}</td>`;
            for (const col of propertyColumns) {
                const val = r.properties && r.properties[col] != null ? r.properties[col] : '#N/A';
                html += `<td>${escapeHtml(val)}</td>`;
            }
            return html;
        }

        function escapeHtml(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

        function escapeAttr(s) {
            return escapeHtml(s).replace(/"/g, '&quot;');
        }

        function formatLinkCell(url) {
            if (!url) return '-';
            const safeUrl = escapeHtml(url);
            const tooltip = escapeAttr(url);
            return `<a href="${safeUrl}" target="_blank" rel="noopener noreferrer" class="link-clip" title="${tooltip}" aria-label="Open product link">` +
                `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">` +
                `<path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 0 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3 3 0 0 1-6 0V3z"/>` +
                `</svg></a>`;
        }

        // ── Export ─────────────────────────────────────────────────────
        document.getElementById('btnExport').addEventListener('click', () => {
            if (!sessionId) return;
            window.location.href = '/api/export/' + sessionId;
        });
    </script>
}
