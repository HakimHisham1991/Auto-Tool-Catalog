<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MonsterASP.NET: InProcess + DLL (see web.config). OutOfProcess + EXE disables the app pool. -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <!-- IIS publish: DLL only — do not upload AutoToolCatalog.exe to shared hosting. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- Keep the Tools/ helper projects fully out of the web project's globbing.
       Otherwise the Web SDK treats Tools/*/bin as content and copies it into this
       project's bin on every build, nesting deeper each time (path-too-long). -->
  <ItemGroup>
    <Compile Remove="Tools/**" />
    <Content Remove="Tools/**" />
    <None Remove="Tools/**" />
    <EmbeddedResource Remove="Tools/**" />
    <InternalsVisibleTo Include="SecoApiTest" />
  </ItemGroup>

  <!-- Ship the SECO master list so SecoGlobalIdStore can seed the lookup on the server. -->
  <ItemGroup>
    <None Update="Data\SECO_GLOBAL_ID.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Chromium bundles are huge and cannot run on typical shared hosting; exclude from FTP publish. -->
  <Target Name="ExcludePlaywrightFromPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(RelativePath)').Contains('.playwright'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageReference Include="System.IO.Packaging" Version="9.0.0" />
  </ItemGroup>

</Project>
